# --- server ---
# PORT is assigned by the host in production; this is the local default.
PORT=4000
NODE_ENV=development

# Browser origins allowed to call the API and open a WebSocket.
# Comma-separated, no trailing slashes. In production this is the deployed
# frontend URL, plus any preview URLs you want to work.
CLIENT_ORIGIN=http://localhost:5173

# --- database ---
MONGO_URI=mongodb://127.0.0.1:27017/collabide

# --- code execution ---
# Unset means the stub: no external service, useful for development and CI.
#
# A public Judge0 instance needs no credentials:
#   JUDGE0_URL=https://ce.judge0.com
#
# The RapidAPI gateway needs a key as well:
#   JUDGE0_URL=https://judge0-ce.p.rapidapi.com
#   JUDGE0_API_KEY=your-rapidapi-key
# JUDGE0_URL=

# --- auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production these are set by the host, never committed.
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-differently
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Snapshot storage ceiling. Production leaves these unset and uses the
# defaults (12MB / 4MB), sized against MongoDB's 16MB per-document limit.
# Lowered here so the oversize guard is actually reachable in tests.
SNAPSHOT_MAX_BYTES=262144
SNAPSHOT_WARN_BYTES=131072

# Stale-room sweep. Production leaves these unset (30 days, every 6 hours).
# The interval is shortened here so the sweep is observable in tests; the TTL
# stays realistic because tests age a room by editing lastActiveAt directly.
CLEANUP_INTERVAL_SECONDS=5
