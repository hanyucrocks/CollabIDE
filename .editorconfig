# Applies to editors that read this file, so a contributor's setup matches the
# repo before Prettier ever runs.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown gives meaning to trailing whitespace (a hard line break).
trim_trailing_whitespace = false
