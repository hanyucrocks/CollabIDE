# Base URL of the API. Vite inlines this at BUILD time, so changing it requires
# a rebuild, not just a restart.
VITE_API_URL=http://localhost:4000

# Optional. Derived from VITE_API_URL when unset (http -> ws, https -> wss),
# which is almost always what you want. Only set it if the WebSocket endpoint
# is on a different host from the REST API.
# VITE_WS_URL=ws://localhost:4000/yjs
